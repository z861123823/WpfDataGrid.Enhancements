<Window x:Class="WpfDataGrid.Enhancements.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:WpfDataGrid.Enhancements;assembly=WpfDataGrid.Enhancements"
        xmlns:theming="clr-namespace:WpfDataGrid.Enhancements.Theming;assembly=WpfDataGrid.Enhancements"
        Title="WPF DataGrid 增强包 Demo"
        Height="640" Width="1080"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="主题：" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="ThemeComboBox" Width="110" SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" Tag="System" />
                    <ComboBoxItem Content="浅色" Tag="Light" />
                    <ComboBoxItem Content="深色" Tag="Dark" />
                </ComboBox>
                <Separator />
                <Button x:Name="ExportCsvButton" Content="导出 CSV" Click="ExportCsv_Click" />
                <Button x:Name="ExportXlsxButton" Content="导出 xlsx" Click="ExportXlsx_Click" />
                <Button x:Name="ExportPdfButton" Content="导出 PDF" Click="ExportPdf_Click" />
                <Separator />
                <ToggleButton x:Name="VirtualModeToggle" Content="大数据模式（10 万行虚拟化）" Checked="VirtualModeToggle_Checked" Unchecked="VirtualModeToggle_Unchecked" />
            </ToolBar>
        </ToolBarTray>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="正在加载…" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="LicenseText" Text="" Margin="12,0,0,0" />
            </StatusBarItem>
        </StatusBar>

        <!-- 主数据表：声明式启用过滤 / 导出 / 主题 -->
        <DataGrid x:Name="MainDataGrid"
                  dg:DataGridExtensions.EnableFiltering="True"
                  dg:DataGridExtensions.EnableExporting="True"
                  dg:DataGridExtensions.ThemeMode="System"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  HeadersVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="70" />
                <DataGridTextColumn Header="下单时间" Binding="{Binding OrderDate}" Width="150" />
                <DataGridTextColumn Header="客户" Binding="{Binding Customer}" Width="100" />
                <DataGridTextColumn Header="区域" Binding="{Binding Region}" Width="70" />
                <DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="100" />
                <DataGridTextColumn Header="品类" Binding="{Binding Category}" Width="80" />
                <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60" />
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice}" Width="90" />
                <DataGridTextColumn Header="金额" Binding="{Binding Amount}" Width="110" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
