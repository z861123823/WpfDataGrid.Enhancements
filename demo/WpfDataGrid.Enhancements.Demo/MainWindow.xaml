<Window x:Class="WpfDataGrid.Enhancements.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dg="clr-namespace:WpfDataGrid.Enhancements;assembly=WpfDataGrid.Enhancements"
        Title="WPF DataGrid 增强包 Demo"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DataGridEnhancements.PageBackground}">
    <Window.Resources>
        <!-- 矢量图标（Geometry，Fill 随主题文本色联动） -->
        <Geometry x:Key="IconUpload">M12 4 L17 9 H14 V15 H10 V9 H7 Z M5 18 H19 V21 H5 Z</Geometry>
        <Geometry x:Key="IconFilter">M4 5 H20 L13.2 12.5 V17 L10.8 19.5 V12.5 Z</Geometry>
        <Geometry x:Key="IconGrid">M4 4 H10 V10 H4 Z M14 4 H20 V10 H14 Z M4 14 H10 V20 H4 Z M14 14 H20 V20 H14 Z</Geometry>
        <Geometry x:Key="IconMoon">M12.5 3 A9 9 0 1 0 21.5 12.5 A7 7 0 0 1 12.5 3 Z</Geometry>
        <Geometry x:Key="IconStar">M12 2.5 L14.6 9.2 H21.8 L15.9 13.6 L18.4 20.3 L12 15.8 L5.6 20.3 L8.1 13.6 L2.2 9.2 H9.4 Z</Geometry>

        <!-- 卡片：圆角 + 阴影 + 主题联动画刷 -->
        <Style x:Key="DemoCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource DataGridEnhancements.CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridEnhancements.CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- 图标按钮：圆角模板 + 悬停/按下反馈 -->
        <Style x:Key="IconButtonBase" TargetType="{x:Type ButtonBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource DataGridEnhancements.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：卡片式圆角按钮 -->
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource DataGridEnhancements.CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridEnhancements.CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DataGridEnhancements.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 数据模式 Toggle：选中态高亮 -->
        <Style x:Key="ModeToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource DataGridEnhancements.CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DataGridEnhancements.CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DataGridEnhancements.TextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DataGridEnhancements.DemoCheckedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DataGridEnhancements.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 头部：品牌 + 授权徽标 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource DataGridEnhancements.TextPrimary}">
                    <Path Data="{StaticResource IconGrid}" Width="20" Height="20" Stretch="Uniform"
                          Fill="{DynamicResource DataGridEnhancements.PageBackground}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="WPF DataGrid 增强包" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource DataGridEnhancements.TextPrimary}" />
                    <TextBlock Text="开源 MIT · 过滤 / 导出 / 主题 / Pro 大数据虚拟化"
                               FontSize="12"
                               Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Padding="10,4" CornerRadius="12"
                    Background="{DynamicResource DataGridEnhancements.CardBackground}"
                    BorderBrush="{DynamicResource DataGridEnhancements.CardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="LicenseText" FontSize="12"
                           Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
            </Border>
        </Grid>

        <!-- 工具栏卡片 -->
        <Border Grid.Row="2" Style="{StaticResource DemoCard}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="主题" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,8,0"
                           Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
                <ComboBox x:Name="ThemeComboBox" Width="128" VerticalAlignment="Center"
                          SelectionChanged="ThemeComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="跟随系统" Tag="System" />
                    <ComboBoxItem Content="浅色" Tag="Light" />
                    <ComboBoxItem Content="深色" Tag="Dark" />
                    <ComboBoxItem Content="自定义（翡翠绿）" Tag="Custom" />
                </ComboBox>
                <Button x:Name="ApplyCustomThemeButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="ApplyCustomTheme_Click" ToolTip="注册并应用运行时自定义主题（DataGridThemeManager.RegisterTheme）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconStar}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <TextBlock Text="自定义主题" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="26" Fill="{DynamicResource DataGridEnhancements.CardBorderBrush}" Margin="16,0" />

                <TextBlock Text="导出" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
                <Button x:Name="ExportCsvButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Click="ExportCsv_Click" ToolTip="导出当前视图为 CSV">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUpload}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <TextBlock Text="CSV" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportXlsxButton" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Click="ExportXlsx_Click" ToolTip="导出当前视图为 xlsx（Pro）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUpload}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <TextBlock Text="xlsx" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportPdfButton" Style="{StaticResource PrimaryButton}"
                        Click="ExportPdf_Click" ToolTip="导出当前视图为 PDF（Pro）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUpload}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <TextBlock Text="PDF" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Height="26" Fill="{DynamicResource DataGridEnhancements.CardBorderBrush}" Margin="16,0" />

                <ToggleButton x:Name="VirtualModeToggle" Style="{StaticResource ModeToggle}"
                              Checked="VirtualModeToggle_Checked" Unchecked="VirtualModeToggle_Unchecked"
                              ToolTip="切换 10 万行普通模式 / 按需分页异步虚拟化模式（Pro）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGrid}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                              Fill="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <TextBlock Text="10 万行虚拟化" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Border>

        <!-- 数据表卡片 -->
        <Border Grid.Row="4" Style="{StaticResource DemoCard}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.20" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="订单数据" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource DataGridEnhancements.TextPrimary}" />
                        <Border Margin="8,0,0,0" Padding="8,2" CornerRadius="10"
                                Background="{DynamicResource DataGridEnhancements.CardBackground}"
                                BorderBrush="{DynamicResource DataGridEnhancements.CardBorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="RowCountChip" FontSize="11"
                                       Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource DataGridEnhancements.TextSecondary}"
                               Text="列头漏斗图标可过滤，点按钮导出当前视图" />
                </Grid>

                <DataGrid x:Name="MainDataGrid"
                          Grid.Row="2"
                          dg:DataGridExtensions.EnableFiltering="True"
                          dg:DataGridExtensions.EnableExporting="True"
                          dg:DataGridExtensions.ThemeMode="System"
                          dg:DataGridAutoFit.AutoFitColumns="True"
                          dg:DataGridAutoFit.StarLastColumn="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          HeadersVisibility="All"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="70" />
                        <DataGridTextColumn Header="下单时间" Binding="{Binding OrderDate}" Width="150" />
                        <DataGridTextColumn Header="客户" Binding="{Binding Customer}" Width="100" />
                        <DataGridTextColumn Header="区域" Binding="{Binding Region}" Width="70" />
                        <DataGridTextColumn Header="产品" Binding="{Binding Product}" Width="100" />
                        <DataGridTextColumn Header="品类" Binding="{Binding Category}" Width="80" />
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="6" Background="Transparent">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="正在加载…"
                           Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="ThemeStatusText" Text="" Margin="12,0,0,0"
                           Foreground="{DynamicResource DataGridEnhancements.TextSecondary}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
