<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WpfDataGrid.Enhancements.Demo</RootNamespace>
    <AssemblyName>WpfDataGrid.Enhancements.Demo</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- 公开仓库默认不引用 Pro：加 /p:EnablePro=true 可启用 Pro 演示（xlsx/PDF/虚拟化）。 -->
    <DefineConstants Condition="'$(EnablePro)' == 'true'">$(DefineConstants);PRO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WpfDataGrid.Enhancements\WpfDataGrid.Enhancements.csproj" />
    <ProjectReference Include="..\..\src\WpfDataGrid.Enhancements.Pro\WpfDataGrid.Enhancements.Pro.csproj" Condition="'$(EnablePro)' == 'true'" />
  </ItemGroup>

</Project>
