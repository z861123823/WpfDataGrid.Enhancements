<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net462</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>WpfDataGrid.Enhancements.Pro</RootNamespace>
    <AssemblyName>WpfDataGrid.Enhancements.Pro</AssemblyName>
    <PackageId>WpfDataGrid.Enhancements.Pro</PackageId>
    <Version>0.9.0</Version>
    <Authors>WpfDataGrid.Enhancements Team</Authors>
    <Description>Pro extensions for WPF DataGrid Enhancements: xlsx/PDF export, advanced filtering, big-data virtualization and license validation. Commercial license; includes a built-in 30-day trial. See LICENSE.txt for terms.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>wpf;datagrid;xlsx;pdf;export;virtualization;filtering;license;commercial</PackageTags>
    <RepositoryUrl>https://github.com/placeholder/WpfDataGrid.Enhancements</RepositoryUrl>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfDataGrid.Enhancements\WpfDataGrid.Enhancements.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfDataGrid.Enhancements.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- xlsx 导出首选 Sylvan.Data.Excel（MIT）；备选 ClosedXML（MIT）；排除 EPPlus -->
    <PackageReference Include="Sylvan.Data.Excel" Version="0.5.8" />
    <!-- PDF 导出：PdfSharp（MIT），规避 QuestPDF 商业授权问题 -->
    <PackageReference Include="PdfSharp" Version="6.1.1" />
  </ItemGroup>

  <!-- 纯 CLI / CI 环境无 .NET Framework 4.6.2 targeting pack 时，从 NuGet 拉取参考程序集 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net462'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
