<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 娣辫壊涓婚锛圗nhancements.Dark锛?==== -->

    <!-- 鍩虹鑹叉澘 -->
    <Color x:Key="DataGridEnhancements.AccentColor">#4C8DFF</Color>
    <SolidColorBrush x:Key="DataGridEnhancements.AccentBrush" Color="{StaticResource DataGridEnhancements.AccentColor}" />
    <SolidColorBrush x:Key="DataGridEnhancements.RowHoverBrush" Color="#1A4C8DFF" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonBackground" Color="#3A3F47" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonForeground" Color="#DCDCDC" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonActiveBackground" Color="#4A515C" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonActiveForeground" Color="#9DC4FF" />

    <!-- DataGrid 鏁翠綋鏍峰紡 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="BorderBrush" Value="#3A3A40" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowBackground" Value="#1E1E1E" />
        <Setter Property="AlternatingRowBackground" Value="#232328" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- 鍒楀ご锛氳儗鏅彁浜竴妗?+ 楂樺姣旂櫧瀛?-->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#33333A" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 琛岋細MinHeight 34 + 鏋佹贰琛屽垎闅旂嚎锛涙偓鍋?Accent 10%銆侀€変腑 Accent 22% -->
    <Style TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#29292E" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridEnhancements.RowHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#384C8DFF" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 鍗曞厓鏍硷細鏄惧紡 ControlTemplate锛堜笉渚濊禆榛樿妯℃澘锛夛紝Border+ContentPresenter 寮哄埗鍨傜洿灞呬腑 -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Foreground" Value="#E6E6E6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="CellBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CellBorder" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 杩囨护鎸夐挳锛堜緵 DataGridFilterBehavior 寮曠敤锛?-->
    <Style x:Key="DataGridEnhancements.FilterButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DataGridEnhancements.FilterButtonBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource DataGridEnhancements.FilterButtonForeground}" />
        <Setter Property="BorderBrush" Value="#565D66" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <!-- 鑷粯杩囨护婕忔枟鍥炬爣锛氬疄蹇冮棴鍚堝嚑浣曪紝Fill 璺熼殢 Foreground锛堟椿鍔ㄦ€佸彲鍒囨崲涓哄己璋冭壊锛夛紱
                             鏄惧紡 Fill 閬垮厤寮€鏀惧紡鎶樼嚎琚粯璁ゅ～鍏呮覆鏌撴垚鑹插潡锛屼袱涓婚鍧囨竻鏅板彲瑙?-->
                        <Path Data="M 1.5,1 L 10.5,1 L 7,5.2 L 7,10 L 5,10 L 5,5.2 Z"
                              Fill="{TemplateBinding Foreground}"
                              Width="13" Height="12"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DataGridEnhancements.FilterButtonActiveBackground}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DataGridEnhancements.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#232733" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Demo 鐣岄潰鑱斿姩閿細鑷畾涔変富棰樿鐩栧悓鍚嶉敭鍗冲彲璁?Demo 鏁翠綋鎹㈣偆 -->
    <SolidColorBrush x:Key="DataGridEnhancements.PageBackground" Color="#17171A" />
    <SolidColorBrush x:Key="DataGridEnhancements.CardBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="DataGridEnhancements.CardBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="DataGridEnhancements.TextPrimary" Color="#E0E0E0" />
    <SolidColorBrush x:Key="DataGridEnhancements.TextSecondary" Color="#9A9A9A" />
    <SolidColorBrush x:Key="DataGridEnhancements.DemoCheckedBrush" Color="#2D5F2D" />

    <!-- 杩囨护闈㈡澘鎸夐挳鏍峰紡锛堜緵 FilterPanel 浠ｇ爜鏋勫缓 UI 寮曠敤锛?-->
    <Style x:Key="DataGridEnhancements.FilterPanelButton" TargetType="Button">
        <Setter Property="Background" Value="#2D2D30" />
        <Setter Property="Foreground" Value="#DCDCDC" />
        <Setter Property="BorderBrush" Value="#555A66" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A3F4B" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8DFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#232733" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 杩囨护闈㈡澘寮瑰眰锛團ilterPanel Popup锛夌編鍖栬祫婧?-->
    <SolidColorBrush x:Key="DataGridEnhancements.FilterPanelBorderBrush" Color="#4A4A52" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterPanelSeparatorBrush" Color="#38383E" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterInputBackground" Color="#26262B" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterInputBorderBrush" Color="#4A4A52" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterCheckHoverBackground" Color="#264C8DFF" />

    <!-- 杩囨护闈㈡澘涓绘寜閽紙搴旂敤锛夛細Accent 搴曠櫧瀛楋紝鎮仠鎻愪寒 -->
    <Style x:Key="DataGridEnhancements.FilterPanelPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="#4C8DFF" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#4C8DFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#6FA1FF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6FA1FF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3A76D6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 杩囨护闈㈡澘澶氶€?/ 寮€鍏抽」 CheckBox锛氭偓鍋滆儗鏅贰鍖栥€侀€変腑鎬?Accent 鏂瑰潡鐧藉嬀 -->
    <Style x:Key="DataGridEnhancements.FilterPanelCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DCDCDC" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="6,3" Margin="0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    BorderThickness="1.5" BorderBrush="#5A5F6A" Background="Transparent"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3.5,8 L 6.8,11.3 L 12.5,4.8"
                                      Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DataGridEnhancements.FilterCheckHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#4C8DFF" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#4C8DFF" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


