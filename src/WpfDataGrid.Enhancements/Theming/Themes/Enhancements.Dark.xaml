<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== 深色主题（Enhancements.Dark）===== -->

    <!-- 基础色板 -->
    <Color x:Key="DataGridEnhancements.AccentColor">#4C8DFF</Color>
    <SolidColorBrush x:Key="DataGridEnhancements.AccentBrush" Color="{StaticResource DataGridEnhancements.AccentColor}" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonBackground" Color="#2D2D30" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonForeground" Color="#DCDCDC" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonActiveBackground" Color="#3A3F4B" />
    <SolidColorBrush x:Key="DataGridEnhancements.FilterButtonActiveForeground" Color="#4C8DFF" />

    <!-- DataGrid 整体样式 -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="#1E1E1E" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#333337" />
        <Setter Property="RowBackground" Value="#1E1E1E" />
        <Setter Property="AlternatingRowBackground" Value="#26262B" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
    </Style>

    <!-- 列头 -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#2D2D30" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 行 -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#333337" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Foreground" Value="#E0E0E0" />
    </Style>

    <!-- 单元格 -->
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="#E0E0E0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 过滤按钮（供 DataGridFilterBehavior 引用） -->
    <Style x:Key="DataGridEnhancements.FilterButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DataGridEnhancements.FilterButtonBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DataGridEnhancements.FilterButtonForeground}" />
        <Setter Property="BorderBrush" Value="#3F3F46" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DataGridEnhancements.FilterButtonActiveBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#232733" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
